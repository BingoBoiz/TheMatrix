<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="matrix-root" class="root-container matrix-root">
        <ui:VisualElement name="matrix-topbar" class="matrix-topbar">
            <ui:Label text="MATRIX" class="matrix-title" />
            <ui:VisualElement class="matrix-topbar-spacer" />
            <ui:Label name="topbar-breadcrumb" text="matrix › construct" class="matrix-breadcrumb" />
            <ui:VisualElement class="matrix-topbar-spacer" />
            <ui:VisualElement name="grid-preset-slot" class="matrix-toolbar-presets" />
            <ui:Button name="kill-all-button" text="KILL ALL" class="btn-secondary btn-compact matrix-kill-all" tooltip="Terminate every running agent turn." />
            <ui:Button name="settings-button" text="⚙" class="btn-tertiary matrix-settings-btn" tooltip="Matrix Space settings: agents, models, logins, API keys." />
        </ui:VisualElement>
        <ui:VisualElement name="matrix-main" class="matrix-main">
            <ui:VisualElement name="sidebar-slot" class="matrix-sidebar-slot" />
            <ui:VisualElement name="matrix-center" class="matrix-center">
                <ui:VisualElement name="pane-grid" class="matrix-pane-grid" />
                <ui:ScrollView name="settings-panel" class="matrix-settings-panel" style="display: none;">
                    <ui:Label text="SYSTEM PARAMETERS" class="matrix-settings-title" />
                    <ui:Toggle name="setting-matrix-persona" label="Matrix persona" tooltip="Activate the matrix skill persona for every new session." />
                    <ui:Toggle name="setting-allow-feeder" label="Allow Feeder-MCP tools" tooltip="Pre-approves mcp__Feeder-MCP__* tools so Claude agents can control Unity in headless mode. Other permissions stay in default mode." />
                    <ui:Toggle name="setting-shared-memory" label="Shared memory + mailbox" tooltip="Injects the MatrixSpace/MEMORY.md + mailbox protocol into every session so agents share knowledge." />
                    <ui:Toggle name="setting-rain" label="Code rain background" />
                    <ui:Toggle name="setting-skip-permissions" label="DANGEROUS: skip ALL permissions" tooltip="Passes --dangerously-skip-permissions: agents can edit files and run commands without any approval. Off unless you fully trust the prompts." />
                    <ui:Label text="AGENTS" class="matrix-settings-title matrix-agents-title" />
                    <ui:VisualElement name="agents-config-container" class="agents-config-container" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
