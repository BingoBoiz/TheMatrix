<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="agent-pane" class="agent-pane">
        <ui:VisualElement name="pane-header" class="agent-pane-header">
            <ui:VisualElement name="status-led" class="status-indicator-circle status-indicator-circle-disconnected agent-pane-led" />
            <ui:Label name="agent-name" text="Claude Code · agent 01" class="agent-pane-name" />
            <ui:Label name="agent-state" text="DORMANT" class="agent-pane-state" />
            <ui:VisualElement class="agent-pane-header-spacer" />
            <ui:Label name="agent-cost" text="" class="agent-pane-cost agent-pane-usage" tooltip="Accumulated token usage and API cost of this session." />
            <ui:Button name="config-button" text="…" class="btn-tertiary agent-pane-header-btn" tooltip="Show backend / model configuration for this pane." />
            <ui:Button name="expand-button" text="▣" class="btn-tertiary agent-pane-header-btn" tooltip="Expand this pane to fill the grid. Click again to restore the layout." />
            <ui:Button name="close-button" text="×" class="btn-tertiary agent-pane-header-btn" tooltip="Reset: discard this conversation and start a fresh session." />
        </ui:VisualElement>
        <ui:VisualElement name="pane-config-row" class="agent-pane-config-row" style="display: none;">
            <ui:Label name="config-usage-label" text="" class="agent-pane-usage-detail" />
        </ui:VisualElement>
        <ui:ScrollView name="transcript-scroll" class="agent-pane-transcript" mode="Vertical">
            <ui:VisualElement name="transcript-content" class="agent-pane-transcript-content" />
        </ui:ScrollView>
        <ui:VisualElement name="input-row" class="agent-pane-input-row">
            <ui:TextField name="prompt-input" multiline="true" class="agent-pane-input styled-text-field" tooltip="Enter = send, Shift+Enter = new line" />
            <ui:Button name="send-button" text="SEND" class="btn-primary btn-compact agent-pane-send" />
            <ui:Button name="stop-button" text="STOP" class="btn-secondary btn-compact agent-pane-stop" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
