<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Feeder.Bridge</RootNamespace>
    <AssemblyName>feeder-mcp-server</AssemblyName>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Authors>Feeder</Authors>
    <Company>Feeder</Company>
    <Product>Feeder MCP Server</Product>
    <AssemblyTitle>Feeder MCP Server</AssemblyTitle>
    <Description>Local Model Context Protocol bridge for Matrix AI Connector and Unity.</Description>
    <Copyright>Copyright © 2026 Feeder</Copyright>
    <RepositoryUrl>https://github.com/BingoBoiz/TheMatrix</RepositoryUrl>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Feeder.Bridge.Protocol\Feeder.Bridge.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Feeder.StdioShim\BridgeRelay.cs" Link="Stdio\BridgeRelay.cs" />
  </ItemGroup>
</Project>
